# Copie para .env e preencha. Nunca commitar o .env de verdade.

# Opção A — Email Testing (Sandbox): pra demos/testes, nada sai de verdade, só aparece no
# inbox de teste do painel do Mailtrap (Sending > Testing > sua inbox > Integration > SMTP).
# Se preenchido, tem prioridade sobre a Sending API abaixo.
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USERNAME=
MAILTRAP_SMTP_PASSWORD=90c312f23f6670

# Opção B — Sending API (produção, domínio verificado): entrega de verdade.
# https://mailtrap.io/api-tokens
MAILTRAP_API_URL=https://send.api.mailtrap.io/api/send
MAILTRAP_API_TOKEN=

MAILTRAP_SENDER_EMAIL=relatos@urbansense.ai
MAILTRAP_SENDER_NAME=UrbanSense AI

# Destino padrão quando o app não manda um to_email explícito.
DEFAULT_CITY_HALL_EMAIL=ouvidoria@surubim.pe.gov.br
DEFAULT_CITY_HALL_NAME=Prefeitura Municipal de Surubim
